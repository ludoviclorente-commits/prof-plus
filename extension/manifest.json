        "https://*.ac-guadeloupe.fr/*",
        "https://*.ac-guyane.fr/*",
        "https://*.ac-lille.fr/*",
        "https://*.ac-limoges.fr/*",
        "https://*.ac-lyon.fr/*",
        "https://*.ac-martinique.fr/*",
        "https://*.ac-mayotte.fr/*",
        "https://*.ac-montpellier.fr/*",
        "https://*.ac-nancy-metz.fr/*",
        "https://*.ac-nantes.fr/*",
        "https://*.ac-nice.fr/*",
        "https://*.ac-normandie.fr/*",
        "https://*.ac-orleans-tours.fr/*",
        "https://*.ac-paris.fr/*",
        "https://*.ac-poitiers.fr/*",
        "https://*.ac-reims.fr/*",
        "https://*.ac-rennes.fr/*",
        "https://*.ac-reunion.fr/*",
        "https://*.ac-strasbourg.fr/*",
        "https://*.ac-toulouse.fr/*",
        "https://*.ac-versailles.fr/*"
      ]
    }
  ]
}